{
  "source": {
  "endpoint": "https://data.cityofnewyork.us/resource/erm2-nwe9.json",
  "start_date": "2024-01-01T00:00:00",
  "end_date_exclusive": "2025-07-01T00:00:00",
  "boroughs": [],
  "complaint_types": [
    "Noise - Residential",
    "Noise - Vehicle",
    "Noise - Street/Sidewalk",
    "Noise - Park",
    "Noise - Commercial"
  ],
  "minimum_records": 300000,
  "seed" : 42
  },
  "http": {
    "batch_size": 5000,
    "timeout_seconds": 60,
    "max_retries": 3,
    "retry_backoff_seconds": 1,
    "max_retry_delay_seconds": 60
  },
  "validation": {
    "schema_path": "config/schema.json",
    "inspection_batches": 6,
    "inspection_sentinel_tokens": ["N/A", "Unspecified", "UNKNOWN", "00000"],
    "inspection_categorical_fields": ["complaint_type", "agency", "borough", "status", "open_data_channel_type"],
    "inspection_category_limit": 100,
    "max_quarantine_fraction": 0.01,
    "schema_drift_min_records": 100,
    "profile_buffer_size": 1000
  },
  "paths": {
    "raw_dir": "data/raw_data",
    "created_dir": "data/created_data",
    "checkpoint_file": "checkpoint.json",
    "inspection_file": "raw_inspection.json",
    "validation_dir": "validation"
  }
}
