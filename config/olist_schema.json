    }
  ],
  "derived_dimensions": {
    "product_categories": {
      "primary_key": [
        "product_category_name"
      ],
      "rule": "Union nonblank categories from products and translation; English name nullable; never invent a translation."
    },
    "postal_areas": {
      "primary_key": [
        "zip_code_prefix"
      ],
      "sql_type": "CHAR(5)",
      "rule": "Union normalized valid prefixes from customers, sellers and geolocation; no direct foreign key to nonunique geolocation points."
    }
  },
  "policy": {
    "blank_optional": "null_without_imputation",
    "invalid_identifier_or_required_value": "quarantine_before_load",
    "invalid_optional_measurement": "null_with_quality_flag_and_raw_provenance",
    "duplicate_primary_key": "quarantine_conflicts_without_silent_first_row_selection",
    "missing_parent": "quarantine_before_load_after_derived_dimensions_are_built",
    "chronology": "Retain source timestamps; flag reversals and exclude invalid durations from metrics, without a universal approval-before-shipping CHECK.",
    "geolocation_exact_duplicates": "deduplicate all five canonical source columns before publication; preserve first source row and audit discarded rows; raw immutable",
    "execution": "cleaning and quarantine before database loading; database writes pending"
  }
}
